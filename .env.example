# Insight — environment configuration template.
# Copy to .env and fill in real values. NEVER commit .env with real credentials.
#
# NOTE (Phase 1 status): the backend does not exist yet, so nothing below is
# consumed by running code today. This file documents the configuration
# surface the backend will read once Phase 2+ lands (see docs/ROADMAP.md).

# --- Database (spec section 16/29) ---
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://insight:changeme@localhost:5432/insight
# SQL Server example (via pyodbc):
# DATABASE_URL=mssql+pyodbc://insight:changeme@localhost:1433/insight?driver=ODBC+Driver+18+for+SQL+Server
DATABASE_URL=

# --- MQTT default broker (spec section 5) ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=false
MQTT_CA_CERTIFICATE=
MQTT_CLIENT_CERTIFICATE=
MQTT_CLIENT_KEY=

# --- Production Context provider (spec sections 15-18) ---
# Selects which IProductionContextProvider implementation the backend uses.
PRODUCTION_CONTEXT_PROVIDER=mock
# SQL Server DWH connection, only used when PRODUCTION_CONTEXT_PROVIDER=sqlserver
DWH_DATABASE_URL=

# --- Security (spec section 37) ---
SECRET_KEY=
